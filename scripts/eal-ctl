#!/bin/bash

GREEN='\033[1;32m'
RED='\033[1;31m'
YELLOW='\033[1;33m'
CYAN='\033[1;36m'
NC='\033[0m'

WHITELIST_FILE="/etc/eal/default_manifest.json"

generate_system_whitelist() {
    echo -e "${CYAN}[*] Generating SHA-256 Whitelist for Core System Binaries...${NC}"
    mkdir -p /etc/eal
    > "$WHITELIST_FILE"

    # List of critical OS binaries that must NEVER be frozen
    CORE_BINARIES=(
        "/usr/bin/Xorg"
        "/usr/sbin/lightdm"
        "/usr/bin/xfce4-session"
        "/usr/bin/xfce4-terminal"
        "/usr/bin/gnome-terminal"
        "/usr/bin/bash"
        "/usr/bin/zsh"
        "/usr/bin/python3"
        "/usr/lib/systemd/systemd"
        "/usr/bin/dbus-daemon"
    )

    for bin in "${CORE_BINARIES[@]}"; do
        if [ -f "$bin" ]; then
            HASH=$(sha256sum "$bin" | awk '{print $1}')
            echo "$HASH" >> "$WHITELIST_FILE"
            echo -e "  [+] Whitelisted: $bin (${HASH:0:12}...)"
        fi
    done
    echo -e "${GREEN}[+] Whitelist generated successfully at $WHITELIST_FILE${NC}\n"
}

start_eal() {
    echo -e "${GREEN}[*] Starting Execution Authorization Layer (EAL)...${NC}"
    generate_system_whitelist
    systemctl start eal.service
    echo -e "${GREEN}[+] EAL is now ACTIVE.${NC}"
}

stop_eal() {
    echo -e "${RED}[*] Halting Execution Authorization Layer (EAL)...${NC}"
    systemctl stop eal.service
    echo -e "${RED}[-] EAL is now INACTIVE.${NC}"
}

status_eal() {
    if systemctl is-active --quiet eal.service; then
        echo -e "EAL Status: ${GREEN}RUNNING (Active Enforcement)${NC}"
    else
        echo -e "EAL Status: ${RED}STOPPED (Disabled)${NC}"
    fi
}


launch_focus_mode() {
    local app="$1"
    if [ -z "$app" ]; then
        echo -e "${YELLOW}Usage: eal-ctl 5 <application_name>${NC}"
        return 64
    fi

    if ! systemctl is-active --quiet eal.service; then
        echo -e "${RED}[-] EAL daemon is not running.${NC}"
        return 1
    fi

    echo -e "${CYAN}[*] Switching EAL into application-scoped Focus Mode for: $app${NC}"
    echo -e "${YELLOW}[*] System-wide EAL evaluation is paused while Focus Mode is active.${NC}"
    systemctl stop eal.service || return 1

    local terminal=""
    for candidate in x-terminal-emulator xfce4-terminal gnome-terminal konsole xterm; do
        if command -v "$candidate" >/dev/null 2>&1; then
            terminal="$candidate"
            break
        fi
    done

    if [ -z "$terminal" ]; then
        echo -e "${RED}[-] No supported terminal emulator found.${NC}"
        systemctl start eal.service
        return 1
    fi

    case "$terminal" in
        gnome-terminal)
            "$terminal" -- bash -lc "/usr/local/bin/eal_focus '$app'; read -rp 'Focus Mode ended. Press Enter...'" & ;;
        konsole)
            "$terminal" -e bash -lc "/usr/local/bin/eal_focus '$app'; read -rp 'Focus Mode ended. Press Enter...'" & ;;
        *)
            "$terminal" -e bash -lc "/usr/local/bin/eal_focus '$app'; read -rp 'Focus Mode ended. Press Enter...'" & ;;
    esac

    local child=$!
    wait "$child"
    systemctl start eal.service
}

show_dashboard() {
    clear
    echo -e "${CYAN}====================================================${NC}"
    echo -e "${CYAN}   EXECUTION AUTHORIZATION LAYER (EAL) DASHBOARD   ${NC}"
    echo -e "${CYAN}====================================================${NC}"
    status_eal
    echo -e "Autostart on Boot: ${YELLOW}DISABLED (Manual Toggle Only)${NC}"
    echo -e "Whitelist File:    $WHITELIST_FILE"
    echo -e "${CYAN}----------------------------------------------------${NC}"
    echo -e "1) Start EAL Daemon"
    echo -e "2) Stop EAL Daemon"
    echo -e "3) Regenerate System Whitelist"
    echo -e "4) View Live Telemetry Stream (journalctl)"
    echo -e "5) Focus Application: 5 <application_name>"
    echo -e "${CYAN}----------------------------------------------------${NC}"
    read -r -p "Select an option [1-5] or use: 5 <application_name>: " choice app_arg

    case $choice in
        1) start_eal ;;
        2) stop_eal ;;
        3) generate_system_whitelist ;;
        4) journalctl -fu eal ;;
        5) launch_focus_mode "$app_arg" ;;
        *) echo "Invalid option." ;;
    esac
}

# CLI Argument Routing
case "$1" in
    start) start_eal ;;
    stop) stop_eal ;;
    status) status_eal ;;
    whitelist) generate_system_whitelist ;;
    logs) journalctl -fu eal ;;
    5) launch_focus_mode "$2" ;;
    "") show_dashboard ;;
    *) echo "Usage: eal-ctl {start|stop|status|whitelist|logs|5 <application_name>}" ;;
esac
